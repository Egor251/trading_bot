{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "trading_bot Operator",
  "version": "0.1.0",
  "identifier": "com.tradingbot.operator",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run build:desktop --prefix ../web && npm run serve:desktop --prefix ../web",
    "beforeBuildCommand": "npm run build:desktop --prefix ../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "trading_bot Operator",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0b1220"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:8787 http://127.0.0.1:8787",
        "frame-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "freeze_prototype": true,
      "asset_protocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
