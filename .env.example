# Copy to .env or set these variables in the process environment.
# Operator UI persists applied AI keys in SQLite (data/storage/records.db,
# table operator_secrets) and loads them on engine start.
# Never commit real credentials.

# ---------------------------------------------------------------------------
# Control plane (REQUIRED for anything beyond a local laptop)
# ---------------------------------------------------------------------------
# Signs the Engine <-> Operator control commands (HALT / RESUME / CONFIG / LIVE).
# Without it the engine only accepts HALT and logs a CRITICAL at boot.
# Generate:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# NOTE: this must be visible to BOTH the engine and the UI process.  A value that
# lives only in .env authenticates the engine but leaves the UI unable to mint
# a token, so every mutating command is denied with "config requires
# authentication".  Export it as a real process env var instead.
TRADING_CONTROL_HMAC_SECRET=

# Signs live-readiness preflight evidence.  Required to enable live mode.
# Generate:  python -c "import secrets;print(secrets.token_urlsafe(48))"
TRADING_EVIDENCE_HMAC_SECRET=

# Feature flag: must be truthy AND have valid evidence before the engine will
# route an order to a live/quik broker.
TRADING_LIVE_ENABLED=

# Explicit opt-in that lets an *unsigned* local peer run CONFIG commands
# (SET_TRADING / SET_SECRETS / RESET_PAPER / paper PLACE_ORDER).  RESUME and
# LIVE are refused even with this on.  Prefer leaving it unset and using
# TRADING_CONTROL_HMAC_SECRET.
TRADING_ALLOW_MOCK=

# Session token for the Operator BFF (browser <-> :8787).  The BFF mints and
# persists one to data/ui/operator_token (0600) if this is unset, and the
# Operator app bootstraps it from GET /api/session.  Set it to share one token
# across several processes/hosts.
OPERATOR_API_TOKEN=

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
CURSOR_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
CEREBRAS_API_KEY=

# Generic CCXT (any exchange when api_key_env points here)
CCXT_API_KEY=
CCXT_SECRET=
CCXT_PASSWORD=

# Bitget (ccxt_market_service.exchange: bitget) — passphrase = BITGET_PASSWORD
BITGET_API_KEY=
BITGET_SECRET=
BITGET_PASSWORD=

# ---------------------------------------------------------------------------
# Traditional markets
# ---------------------------------------------------------------------------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
