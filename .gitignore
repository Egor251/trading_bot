# --- secrets / local ---
.env
.env.*
!.env.example
data/secrets.env

# --- runtime data ---
# The whole data tree is runtime state. Previously only some subdirectories were
# ignored, so `data/ohlc_cache` (2 MB of cached OHLCV), `data/cost_schedules` and
# `data/ai_reports` were one `git add -A` away from being committed.
data/
logs/
*.db
*.db-*
*.duckdb
*.chdb/
*.log
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# --- build trees ---
# `ui/desktop` had no .gitignore of its own, so `git add -A` pulled the whole
# Tauri node_modules and cargo target/ (hundreds of MB) into the index.
node_modules/
**/node_modules/
ui/desktop/src-tauri/target/
**/target/
ui/web/.next/
ui/web/out/
ui/desktop/gen/schemas/*.json

# --- IDE ---
.idea/
.vscode/
*.swp

# Private strategies / extension plugins
strategies_local/*
!strategies_local/README.md
plugins_local/*
!plugins_local/README.md

# --- Tracked strategies (StrategyPlugin) ---
# Base class: engine/strategy_plugin.py
#
# All 21 strategies under strategies/ are tracked. The previous allow-list kept
# only 5, so 16 strategies — including every entry named in
# `trading.ensemble.observe` and every one the Operator UI lists — existed only
# on the developer's disk. A fresh clone loaded 5 strategies, the consilium
# silently degraded, and no strategy fix could ever be committed.
#
# Private strategies belong in `strategies_local/` (ignored above), which is what
# `plugins.installed_paths` reads.
strategies/*/__pycache__/
!strategies/__init__.py
!strategies/README.md
!strategies/*/

# --- Tracked non-strategy plugins ---
# order_execution, ai_analyst, market connectors under plugins/market/
plugins/*
!plugins/__init__.py
!plugins/order_execution/
!plugins/order_execution/**
!plugins/ai_analyst/
!plugins/ai_analyst/**
!plugins/market/
!plugins/market/**
# The negations above re-include *everything* under plugins/, bytecode included.
# Re-ignore compiled artefacts after them so a stray .pyc can never be committed
# alongside the sources the negations exist to track.
plugins/**/__pycache__/
plugins/**/*.py[cod]
